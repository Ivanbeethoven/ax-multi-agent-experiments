# /etc/s3fs/s3fs.env — s3fs 挂载参数配置文件（权限建议 0600）
# 修改后执行: s3fs-node-ctl remount  （单机）或 s3fs-cluster mount （6机批量）

# S3 服务端地址（例如 RustFS / MinIO / Ceph RGW 内网地址）
S3_URL="http://175.168.6.72:9000"

# 要挂载的 Bucket 名称（需事先在对象存储中存在）
S3_BUCKET="bench-bucket"

# 访问密钥（Access Key / Secret Key）
S3_ACCESS_KEY="REPLACE_WITH_ACCESS_KEY"
S3_SECRET_KEY="REPLACE_WITH_SECRET_KEY"

# 本地挂载目录
S3_MOUNTPOINT="/mnt/s3fs"

# 1 = 使用路径风格 (http://host:port/bucket)，RustFS / MinIO 必须设为 1；虚拟主机风格设为 0
S3_USE_PATH_STYLE="1"

# s3fs 附加挂载参数（兼顾并发与兼容性）
S3_EXTRA_OPTS="allow_other,nonempty,umask=0022,mp_umask=0022,parallel_count=16,multipart_size=16"
