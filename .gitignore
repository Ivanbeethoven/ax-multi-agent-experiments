# Rebuildable visual inspection images; keep the reviewed PDF and checks.
validation/render/
validation/preview/
__pycache__/
/tools/fs-probe/target/
/tools/ml-corpus-scan/target/

# Generated data, runtime configs, credentials and large private results.
runs/
*.local.json

# Imported local toolchains and raw bundles; keep them on disk, out of Git.
.terraform/
*.tfstate
*.tfstate.*
# Preserve the retired cloud directory's local configuration exclusions.
/infra/**/*.tfplan
/infra/**/terraform.tfvars
/infra/**/managed-services.tfvars
/infra/**/*.auto.tfvars
/infra/**/crash.log
/infra/**/inventory.json
/infra/**/generated-*/
/experiments/cloud-smoke/**/brewfs-linux-amd64
/experiments/cloud-smoke/**/*.tar.gz

# Rebuildable intermediates from the archived experiment report.
/experiments/ax-multi-agent/report/*.aux
/experiments/ax-multi-agent/report/*.fdb_latexmk
/experiments/ax-multi-agent/report/*.fls
/experiments/ax-multi-agent/report/*.out
/experiments/ax-multi-agent/report/*.xdv
