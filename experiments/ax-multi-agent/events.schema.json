{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed cloud Agent state observation event",
  "description": "One JSON object per line. No recorded event is supplied. Preserve raw logs and source offsets; null means unobserved, never zero.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "batch_id",
    "event_id",
    "source",
    "clock_domain",
    "monotonic_ns",
    "kind",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "coordinator",
        "agent",
        "tool",
        "fuse",
        "entity",
        "s3_client",
        "rustfs",
        "metadata",
        "grader",
        "cloud_control",
        "filesystem",
        "checkpoint",
        "scheduler",
        "gc"
      ]
    },
    "clock_domain": {
      "type": "string",
      "minLength": 1
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "begin",
        "ok",
        "error",
        "incomplete",
        "timeout",
        "unsupported",
        "rejected",
        "cancelled",
        "ungraded"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "type": [
        "string",
        "null"
      ]
    },
    "layer": {
      "enum": [
        "lower",
        "upper",
        "control",
        null
      ]
    },
    "errno": {
      "type": [
        "integer",
        "null"
      ]
    },
    "path_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "handle_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "offset_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "requested_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "returned_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "object_length_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "physical_read_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "physical_write_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "duration_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "payload_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload_artifact": {
      "type": [
        "string",
        "null"
      ]
    },
    "range_header": {
      "type": [
        "string",
        "null"
      ]
    },
    "effective_layout": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "B_bytes",
        "q_bytes",
        "d",
        "p"
      ],
      "properties": {
        "B_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "q_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "d": {
          "type": "integer",
          "minimum": 1
        },
        "p": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "lease_generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "checkpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_source_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_line_or_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "baseline_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_node": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_node": {
      "type": [
        "string",
        "null"
      ]
    },
    "old_generation": {
      "type": [
        "string",
        "null"
      ]
    },
    "new_generation": {
      "type": [
        "string",
        "null"
      ]
    },
    "volume_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "availability_zone": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "scheduled_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "submitted_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "started_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "completed_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "queue_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "neighbor_task": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deadline_met": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "result_correct": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "migration_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "writer_generation": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_class": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
