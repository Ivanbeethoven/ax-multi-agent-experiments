+async fn local_metadata_packed_edits_read_latest_then_survive_remote_barrier() {
+    use crate::meta::store::{SetAttrFlags, SetAttrRequest};
+    use crate::workspace_overlay::stores::local_metadata::LocalMetadataConfig;
