+        Some(ino)
+    );
+    f.meta.unlink(1, "renamed-journal-file").await.unwrap();
+    f.meta.flush_metadata().await.unwrap();
+    assert_eq!(
+        f.meta.lookup(1, "renamed-journal-file").await.unwrap(),
+        None
+    );
+    shutdown(&f).await;
