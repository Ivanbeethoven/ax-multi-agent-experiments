{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrewFS future executed-run observation",
  "description": "Collection contract only. This schema contains no measured data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "run_id", "experiment_id", "task_id", "replication_id", "configuration_sha256", "raw_manifest_sha256", "outcome", "metrics", "layout_audit"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "executed"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "enum": ["qualification", "overlay_fork", "retention", "packed_access", "packed_lifecycle", "object_granularity", "migration", "recovery", "replay", "scale", "agent_validation"]},
    "task_id": {"type": "string", "minLength": 1},
    "replication_id": {"type": "integer", "minimum": 0},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {
      "type": "object",
      "required": ["completion", "quality_evaluated", "quality_passed", "failure_reason"],
      "properties": {
        "completion": {"enum": ["completed", "failed", "timed_out", "unsupported", "infrastructure_error"]},
        "quality_evaluated": {"type": "boolean"},
        "quality_passed": {"type": ["boolean", "null"]},
        "failure_reason": {"type": ["string", "null"]}
      }
    },
    "metrics": {
      "type": "object",
      "description": "Null means unobserved, never zero. Counters use bytes or counts; times use seconds.",
      "properties": {
        "task_wall_seconds": {"type": ["number", "null"], "minimum": 0},
        "provision_to_ready_seconds": {"type": ["number", "null"], "minimum": 0},
        "remote_complete_seconds": {"type": ["number", "null"], "minimum": 0},
        "all_debt_drained_seconds": {"type": ["number", "null"], "minimum": 0},
        "useful_application_read_bytes": {"type": ["integer", "null"], "minimum": 0},
        "committed_application_write_bytes": {"type": ["integer", "null"], "minimum": 0},
        "http_payload_read_bytes": {"type": ["integer", "null"], "minimum": 0},
        "http_payload_upload_bytes": {"type": ["integer", "null"], "minimum": 0},
        "data_shard_pread_return_bytes": {"type": ["integer", "null"], "minimum": 0},
        "parity_shard_pread_return_bytes": {"type": ["integer", "null"], "minimum": 0},
        "block_device_read_bytes": {"type": ["integer", "null"], "minimum": 0},
        "block_device_write_bytes": {"type": ["integer", "null"], "minimum": 0},
        "lower_kv_rpc_count": {"type": ["integer", "null"], "minimum": 0},
        "upper_kv_rpc_count": {"type": ["integer", "null"], "minimum": 0},
        "control_kv_rpc_count": {"type": ["integer", "null"], "minimum": 0},
        "get_count": {"type": ["integer", "null"], "minimum": 0},
        "head_count": {"type": ["integer", "null"], "minimum": 0},
        "retry_count": {"type": ["integer", "null"], "minimum": 0},
        "checksum_cpu_seconds": {"type": ["number", "null"], "minimum": 0},
        "ec_cpu_seconds": {"type": ["number", "null"], "minimum": 0},
        "retained_object_bytes": {"type": ["integer", "null"], "minimum": 0},
        "private_metadata_bytes": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "layout_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_key_digest", "wire_length_bytes", "effective_b_bytes", "effective_q_bytes", "data_shards", "parity_shards", "inline", "marker", "read_policy"],
        "properties": {
          "object_key_digest": {"type": "string", "minLength": 1},
          "wire_length_bytes": {"type": "integer", "minimum": 0},
          "effective_b_bytes": {"type": ["integer", "null"], "minimum": 1},
          "effective_q_bytes": {"type": ["integer", "null"], "minimum": 1},
          "data_shards": {"type": "integer", "minimum": 1},
          "parity_shards": {"type": "integer", "minimum": 0},
          "inline": {"type": "boolean"},
          "marker": {"type": ["string", "null"]},
          "read_policy": {"enum": ["range", "full_object", "cache_hit", "fallback"]}
        }
      }
    }
  }
}
