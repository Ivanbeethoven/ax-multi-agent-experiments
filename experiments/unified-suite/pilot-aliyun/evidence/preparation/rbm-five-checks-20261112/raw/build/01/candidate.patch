new file mode 100644
index 0000000..982c715
--- /dev/null
+++ b/src/cli/packed_snapshot_publish.rs
@@ -0,0 +1,165 @@
+//! Operator entry point for the trusted, bounded Packed publication driver.
+
+use super::*;
+use crate::workspace_overlay::packed_v3::wire005::V3MountBudget;
+use crate::workspace_overlay::stores::kv_backend::WorkspaceKvBackend;
+use crate::workspace_overlay::stores::kv_store::packed_admin::{
+    PackedCleanAdmission, PackedHeadlessSnapshotDescription, PackedHeadlessSnapshotFailure,
+    PackedHeadlessSnapshotRequest, PackedSnapshotResult,
+};
+
+// Keep an unresolved publication's runtime and scratch owner alive with the
+// returned error. The committed revision, if any, does not prove clean finish.
+struct PublicationFailure(Mutex<PackedHeadlessSnapshotFailure>);
+
+impl std::fmt::Display for PublicationFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        let failure = self.0.lock().unwrap_or_else(|error| error.into_inner());
+        if let Some(result) = failure.committed_result() {
+            write!(
+                f,
+                "Packed snapshot {} committed as {}, but clean completion failed: {}",
+                result.snapshot_id,
+                result.packed_carrier_revision,
+                failure.error(),
+            )
+        } else {
+            write!(f, "Packed snapshot publication failed: {}", failure.error())
+        }
+    }
+}
+
+impl std::fmt::Debug for PublicationFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        std::fmt::Display::fmt(self, f)
+    }
+}
+
+impl std::error::Error for PublicationFailure {}
+
+pub(super) fn requires_retention(result: &anyhow::Result<()>) -> bool {
+    result
+        .as_ref()
+        .err()
+        .is_some_and(|error| error.is::<PublicationFailure>())
+}
+
+pub(super) async fn run<B: WorkspaceKvBackend>(
+    catalog: Arc<KvWorkspaceStore<B>>,
+    budget: Arc<V3MountBudget>,
+    args: PublishPackedSnapshotArgs,
+) -> anyhow::Result<()> {
+    let config = workspace_bucket::config(&args.config)?;
+    if config.volume_format != VolumeFormat::WorkspaceV1
+        || config
+            .workspace
+            .is_some_and(|workspace| workspace != *args.workspace.as_uuid())
+    {
+        anyhow::bail!("Packed publication requires the source workspace-v1 mount configuration");
+    }
+    if args.name.trim().is_empty() {
+        anyhow::bail!("--name must not be empty");
+    }
+    let layout = ChunkLayout {
+        chunk_size: config.chunk_size,
+        block_size: config.block_size,
+    };
+    let workspace = catalog.load_workspace(args.workspace).await?;
+    let temporary = Arc::new(
+        tempfile::Builder::new()
+            .prefix("brewfs-packed-publish-")
+            .tempdir_in(args.scratch)?,
+    );
+    let request = PackedHeadlessSnapshotRequest::bounded_operator(
+        PackedHeadlessSnapshotDescription {
+            snapshot_id: args.snapshot_id,
+            snapshot_name: args.name,
+            owner_id: args.owner,
+        },
+        args.lease_id,
+        args.journal_id,
+        args.next_head,
+        args.ttl_seconds * 1_000_000_000,
+        temporary.path().to_path_buf(),
+    )
+    .with_temporary_owner(temporary.clone())?;
+    let mut block_cache = config.cache.clone();
+    block_cache.cache_root = temporary.path().join("upper-cache");
+    let result = match config.data_backend {
+        DataBackendKind::LocalFs => {
+            if workspace.upper_bucket.is_some() {
+                anyhow::bail!("source has an S3 upper bucket; LocalFS config does not match");
+            }
+            let client = create_localfs_client(&config)?;
+            let upper =
+                Arc::new(create_object_store(client.clone(), layout, &block_cache, true).await?);
+            publish_released(
+                catalog,
+                budget,
+                args.workspace,
+                client,
+                upper,
+                layout,
+                request,
+            )
+            .await?
+        }
+        DataBackendKind::S3 => {
+            let client = create_s3_client(&config).await?;
+            let mut upper_config = config;
+            if let Some(bucket) = workspace.upper_bucket {
+                upper_config.s3_bucket = Some(bucket);
+            }
+            let upper_client = create_s3_client(&upper_config).await?;
+            let upper =
+                Arc::new(create_object_store(upper_client, layout, &block_cache, true).await?);
+            publish_released(
+                catalog,
+                budget,
+                args.workspace,
+                client,
+                upper,
+                layout,
+                request,
+            )
+            .await?
+        }
+    };
+    print_json(&serde_json::json!({
+        "snapshot_id": result.snapshot_id,
+        "fork_source": result.packed_carrier_revision.to_string(),
+        "native_sealed_source": result.native_sealed_source_revision.to_string(),
+        "manifest_key": result.binding.binding.manifest.key,
