+pub(super) async fn publish_released<B, O, S>(
+    catalog: Arc<KvWorkspaceStore<B>>,
+    budget: Arc<V3MountBudget>,
+    workspace: WorkspaceId,
+    client: ObjectClient<O>,
+    upper: Arc<S>,
+    layout: ChunkLayout,
+    request: PackedHeadlessSnapshotRequest,
+) -> anyhow::Result<PackedSnapshotResult>
+where
+    B: WorkspaceKvBackend,
+    O: ObjectBackend + Clone + 'static,
+    S: BlockStore + Send + Sync + 'static,
+{
+    let release = catalog
+        .inspect_original_clean_packed_mount(workspace)
+        .await?
+        .ok_or_else(|| anyhow::anyhow!("source has no current clean Packed unmount receipt"))?;
+    let ticket = match catalog.admit_clean_packed_source(release, budget).await? {
+        PackedCleanAdmission::Ready(ticket) => ticket,
+        PackedCleanAdmission::RequiresRecovery => {
+            anyhow::bail!("source needs Packed mount recovery before publication")
+        }
+    };
+    catalog
+        .publish_clean_packed_snapshot(ticket, client, upper, layout, request)
+        .await
+        .map_err(|failure| PublicationFailure(Mutex::new(failure)).into())
+}
