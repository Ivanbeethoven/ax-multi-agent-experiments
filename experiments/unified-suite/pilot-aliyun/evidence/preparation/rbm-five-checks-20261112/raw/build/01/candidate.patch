+    client: ConnectionManager,
+    index: Vec<u8>,
+}
+
+impl RedisPlacementKv {
+    pub(super) async fn connect(url: &str, prefix: &str) -> PackedResult<Self> {
+        let client = redis::Client::open(url).map_err(backend)?;
+        Ok(Self {
+            client: client.get_connection_manager().await.map_err(backend)?,
+            index: format!("{prefix}/__index").into_bytes(),
+        })
+    }
+}
+
+const PUT: &str = r#"
+local kind = redis.call('TYPE',KEYS[3])
+if type(kind)=='table' then kind=kind.ok end
+if kind~='none' and kind~='zset' then return redis.error_reply('invalid namespace index') end
+if redis.call('EXISTS',KEYS[1])~=0 then return redis.error_reply('published namespace is immutable') end
+local old=redis.call('GET',KEYS[2])
+if old and old~=ARGV[1] then return redis.error_reply('import record changed') end
+if not old then redis.call('SET',KEYS[2],ARGV[1]) end
+redis.call('ZADD',KEYS[3],0,KEYS[2])
+return 1
+"#;
+const PUBLISH: &str = r#"
+local old=redis.call('GET',KEYS[1])
+if old and old~=ARGV[1] then return redis.error_reply('ready binding changed') end
+if not old then redis.call('SET',KEYS[1],ARGV[1]) end
+return 1
+"#;
+const GET: &str = r#"
+if redis.call('STRLEN',KEYS[1])>tonumber(ARGV[1]) then return redis.error_reply('record exceeds limit') end
+return redis.call('GET',KEYS[1])
+"#;
+const SCAN: &str = r#"
+local keys=redis.call('ZRANGEBYLEX',KEYS[1],ARGV[1],ARGV[2],'LIMIT',0,ARGV[3])
+for _,key in ipairs(keys) do
+  if redis.call('STRLEN',key)>tonumber(ARGV[4]) then return redis.error_reply('record exceeds limit') end
+  if redis.call('EXISTS',key)==0 then return redis.error_reply('indexed record missing') end
+end
+local rows={}
+for _,key in ipairs(keys) do
+  table.insert(rows,key);table.insert(rows,redis.call('GET',key))
+end
+return rows
+"#;
+
+#[async_trait]
+impl NativePlacementKv for RedisPlacementKv {
+    async fn get(&self, key: Vec<u8>) -> PackedResult<Option<Vec<u8>>> {
+        redis::Script::new(GET)
+            .key(key)
+            .arg(MAX_RECORD + 68)
+            .invoke_async(&mut self.client.clone())
+            .await
+            .map_err(backend)
+    }
+    async fn scan(
+        &self,
+        start: Vec<u8>,
+        end: Vec<u8>,
+        limit: u32,
+    ) -> PackedResult<Vec<(Vec<u8>, Vec<u8>)>> {
+        if limit == 0 || limit > super::PAGE as u32 {
+            return Err(invalid("Redis scan page limit"));
+        }
+        let rows: Vec<Vec<u8>> = redis::Script::new(SCAN)
+            .key(&self.index)
+            .arg([b"[".as_slice(), &start].concat())
+            .arg([b"(".as_slice(), &end].concat())
+            .arg(limit)
+            .arg(MAX_RECORD + 68)
+            .invoke_async(&mut self.client.clone())
+            .await
+            .map_err(backend)?;
+        if rows.len() % 2 != 0 {
+            return Err(invalid("Redis scan response pairs"));
+        }
+        let mut result = Vec::with_capacity(rows.len() / 2);
+        let mut rows = rows.into_iter();
+        while let Some(key) = rows.next() {
+            result.push((key, rows.next().expect("checked pairs")));
+        }
+        Ok(result)
+    }
+    async fn put_import(&self, ready: Vec<u8>, key: Vec<u8>, value: Vec<u8>) -> PackedResult<()> {
+        if value.len() > MAX_RECORD + 68 {
+            return Err(invalid("Redis import record size"));
+        }
+        let _: i64 = redis::Script::new(PUT)
+            .key(ready)
+            .key(key)
+            .key(&self.index)
+            .arg(value)
+            .invoke_async(&mut self.client.clone())
+            .await
+            .map_err(backend)?;
+        Ok(())
+    }
+    async fn publish(&self, ready: Vec<u8>, value: Vec<u8>) -> PackedResult<()> {
+        if value.len() > MAX_RECORD + 68 {
+            return Err(invalid("Redis ready record size"));
+        }
+        let _: i64 = redis::Script::new(PUBLISH)
+            .key(ready)
+            .arg(value)
+            .invoke_async(&mut self.client.clone())
+            .await
+            .map_err(backend)?;
+        Ok(())
+    }
+}
