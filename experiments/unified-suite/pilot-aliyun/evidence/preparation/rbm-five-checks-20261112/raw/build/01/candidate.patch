+            Err(MetaError::Io(error)) if error.raw_os_error() == Some(libc::EROFS)
+        ));
+        let attr = f.meta.stat(400).await.unwrap().unwrap();
+        assert!(matches!(
+            f.meta.record_open(400, attr.clone(), false, true, false).await,
+            Err(MetaError::Io(error)) if error.raw_os_error() == Some(libc::EROFS)
+        ));
+        f.meta
+            .record_open(400, attr, true, false, false)
+            .await
+            .unwrap();
+
+        let fence = f
+            .meta
+            .begin_unified_read_request(400)
+            .await
+            .unwrap()
+            .unwrap();
+        let prepared = f
+            .meta
+            .prepare_unified_read(400, 0, 9, 55)
+            .await
+            .unwrap()
+            .unwrap();
+        let mut output = [0; 55];
+        execute_unified_into(prepared.fetcher.as_ref(), 9, &prepared.plan, &mut output)
+            .await
+            .unwrap();
+        fence.ensure_current().await.unwrap();
+        f.meta.record_close(400).await.unwrap();
+        assert_eq!(&output, &f.payload[9..64]);
