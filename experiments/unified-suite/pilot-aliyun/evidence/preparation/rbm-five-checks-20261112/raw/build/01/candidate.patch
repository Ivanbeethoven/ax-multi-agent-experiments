+    match command {
+        WorkspaceCommand::Fork {
+            source,
+            count,
+            owner,
+            data_config,
+            require_packed_carrier: true,
+        } => {
+            validate_workspace_header(&store).await?;
+            let config = workspace_bucket::config(&data_config)?;
+            let children = workspace_bucket::fork_packed(&store, source, count, owner, |id| {
+                workspace_bucket::create(&config, id)
+            })
+            .await?;
+            print_json(&children)
+        }
+        #[cfg(target_os = "linux")]
+        WorkspaceCommand::PublishPackedSnapshot(arguments) => {
+            validate_workspace_header(&store).await?;
+            packed_snapshot_publish::run(store, packed_budget, *arguments).await
+        }
+        command => workspace_cmd_with_catalog(command, store).await,
+    }
+}
