+pub(super) async fn fork_packed<B, F, Fut>(
+    store: &KvWorkspaceStore<B>,
+    revision: BaseRevision,
+    count: usize,
+    owner: Option<String>,
+    mut create_upper: F,
+) -> anyhow::Result<Vec<WorkspaceRecord>>
+where
+    B: WorkspaceKvBackend,
+    F: FnMut(WorkspaceId) -> Fut,
+    Fut: Future<Output = anyhow::Result<Option<String>>>,
+{
+    if !(1..=512).contains(&count) {
+        anyhow::bail!("--count for a Packed carrier fork must be between 1 and 512");
+    }
+    // Reject a non-carrier before even creating an S3 upper bucket. Child
+    // creation checks the proof again in the same CAS as workspace birth.
+    store.inspect_packed_carrier_revision(&revision).await?;
+    let mut rows = Vec::with_capacity(count);
+    for _ in 0..count {
+        let workspace_id = WorkspaceId::new();
+        let upper_bucket = create_upper(workspace_id).await?;
+        rows.push(
+            store
+                .create_workspace_from_packed_carrier(CreateWorkspace {
+                    workspace_id,
+                    head_layer_id: crate::workspace_overlay::ids::LayerId::new(),
+                    base_revision: revision.clone(),
+                    owner_id: owner.clone(),
+                    upper_bucket,
+                })
+                .await?,
+        );
+    }
+    Ok(rows)
+}
