+#[cfg(feature = "workspace-overlay")]
+async fn workspace_cmd_with_kv_catalog<
+    B: crate::workspace_overlay::stores::kv_backend::WorkspaceKvBackend,
+>(
+    command: WorkspaceCommand,
+    store: Arc<KvWorkspaceStore<B>>,
