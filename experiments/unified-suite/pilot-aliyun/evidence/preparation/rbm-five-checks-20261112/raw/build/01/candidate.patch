new file mode 100644
index 0000000..a8a2da6
--- /dev/null
+++ b/src/workspace_overlay/meta_layer/packed_read_control.rs
@@ -0,0 +1,331 @@
+//! Read-only ablations on the same WorkspaceMetaLayer, lease, permissions
+//! and wire005 lower. The read-data pair omits the empty extent resolver;
+//! the broader read pair also omits proved-empty namespace queries.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+use super::{
+    HeadGuard, InodeState, LayerRecord, MetaError, WorkspaceError, WorkspaceMetaLayer,
+    WorkspaceStore, validate_fixed_layer_pair, workspace_to_meta,
+};
+use crate::meta::MetaLayer;
+use crate::workspace_overlay::digest::{CanonicalLayerDelta, delta_digest, root_hash};
+
+pub(crate) const PACKED_READ_CONTROL_ENV: &str = "BREWFS_PACKED_WORKSPACE_READ_CONTROL";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum PackedReadControl {
+    Overlay,
+    LowerOnly,
+    OverlayRead,
+    LowerRead,
+}
+
+impl PackedReadControl {
+    pub(crate) fn from_env() -> anyhow::Result<Option<Self>> {
+        match std::env::var(PACKED_READ_CONTROL_ENV) {
+            Ok(mode) if mode == "overlay" => Ok(Some(Self::Overlay)),
+            Ok(mode) if mode == "lower-only" => Ok(Some(Self::LowerOnly)),
+            Ok(mode) if mode == "overlay-read" => Ok(Some(Self::OverlayRead)),
+            Ok(mode) if mode == "lower-read" => Ok(Some(Self::LowerRead)),
+            Err(std::env::VarError::NotPresent) => Ok(None),
+            _ => anyhow::bail!(
+                "{PACKED_READ_CONTROL_ENV} must be overlay, lower-only, overlay-read, or lower-read"
+            ),
+        }
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Self::Overlay => "overlay",
+            Self::LowerOnly => "lower-only",
+            Self::OverlayRead => "overlay-read",
+            Self::LowerRead => "lower-read",
+        }
+    }
+
+    fn measures_namespace(self) -> bool {
+        matches!(self, Self::OverlayRead | Self::LowerRead)
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(super) enum NamespaceRead {
+    Lookup = 0,
+    Getattr = 1,
+    DirectoryProbe = 2,
+}
+
+#[derive(Debug, Default)]
+struct NamespaceCounters {
+    queries: AtomicU64,
+    cache_hits: AtomicU64,
+    bypasses: AtomicU64,
+}
+
+#[derive(Debug)]
+pub(super) struct PackedReadControlWitness {
+    mode: PackedReadControl,
+    guard: HeadGuard,
+    layers: [LayerRecord; 2],
+    extent_queries: AtomicU64,
+    extent_bypasses: AtomicU64,
+    native_root: i64,
+    root_preserved: AtomicU64,
+    namespace: [NamespaceCounters; 3],
+}
+
+impl PackedReadControlWitness {
+    pub(super) fn record_extent_resolution(&self) -> bool {
+        let bypass = matches!(
+            self.mode,
+            PackedReadControl::LowerOnly | PackedReadControl::LowerRead
+        );
+        let counter = if bypass {
+            &self.extent_bypasses
+        } else {
+            &self.extent_queries
+        };
+        counter.fetch_add(1, Ordering::Relaxed);
+        bypass
+    }
+
+    pub(super) fn record_namespace_bypass(&self, op: NamespaceRead, count: u64) -> bool {
+        if self.mode != PackedReadControl::LowerRead {
+            return false;
+        }
+        self.namespace[op as usize]
+            .bypasses
+            .fetch_add(count, Ordering::Relaxed);
+        true
+    }
+
+    pub(super) fn record_namespace_resolution(&self, op: NamespaceRead, cache_hit: bool) {
+        let counters = &self.namespace[op as usize];
+        let counter = if cache_hit {
+            &counters.cache_hits
+        } else {
+            &counters.queries
+        };
+        counter.fetch_add(1, Ordering::Relaxed);
+    }
+
+    pub(super) fn preserve_root_inode(&self, ino: i64, view_root: i64) -> bool {
+        if ino != self.native_root && ino != view_root {
+            return false;
+        }
+        self.root_preserved.fetch_add(1, Ordering::Relaxed);
+        true
+    }
+
+    pub(super) fn render_into(&self, output: &mut dyn std::fmt::Write) {
+        let _ = writeln!(
+            output,
+            "brewfs_workspace_read_extent_control_info{{mode=\"{}\"}} 1",
+            self.mode.name()
+        );
+        let _ = writeln!(
+            output,
+            "brewfs_workspace_read_extent_control_queries_total {}",
+            self.extent_queries.load(Ordering::Relaxed)
+        );
+        let _ = writeln!(
+            output,
+            "brewfs_workspace_read_extent_control_bypasses_total {}",
+            self.extent_bypasses.load(Ordering::Relaxed)
+        );
+        if !self.mode.measures_namespace() {
+            return;
+        }
+        let _ = writeln!(
+            output,
+            "brewfs_workspace_read_namespace_control_root_preserved_total {}",
+            self.root_preserved.load(Ordering::Relaxed)
+        );
+        for (op, counters) in ["lookup", "getattr", "directory_probe"]
+            .into_iter()
+            .zip(&self.namespace)
+        {
+            for (kind, value) in [
+                ("queries", &counters.queries),
+                ("cache_hits", &counters.cache_hits),
+                ("bypasses", &counters.bypasses),
+            ] {
+                let _ = writeln!(
+                    output,
+                    "brewfs_workspace_read_namespace_control_{op}_{kind}_total {}",
+                    value.load(Ordering::Relaxed)
+                );
+            }
+        }
+    }
+}
+
+fn no_native_rows_except_inode(delta: &CanonicalLayerDelta) -> bool {
+    delta.dentries.is_empty()
+        && delta.extents.is_empty()
+        && delta.xattrs.is_empty()
+        && delta.acls.is_empty()
+}
+
+impl<W: WorkspaceStore + 'static> WorkspaceMetaLayer<W> {
+    /// Called once, after regular packed mount admission and before exposing
+    /// FUSE. The small native root stub is expected for initial packed seeds.
+    pub(crate) async fn enable_packed_read_control(
+        &self,
+        mode: PackedReadControl,
+    ) -> Result<(), MetaError> {
+        let invalid = || {
+            MetaError::NotSupported(
+                "Packed read control requires a fresh empty upper and sealed root-only stub".into(),
+            )
+        };
+        let lower = self.packed_lower().ok_or_else(invalid)?;
+        let guard = self.guard().await;
+        let layers: [LayerRecord; 2] = self
+            .store
+            .load_layer_chain(guard.expected_head_layer_id)
+            .await
+            .map_err(workspace_to_meta)?
+            .try_into()
+            .map_err(|_| invalid())?;
+        validate_fixed_layer_pair(&layers).map_err(workspace_to_meta)?;
+        let [head, base] = &layers;
+        // Initial Packed binding consumes one head sequence without writing
+        // any native upper rows. Admit that state, not the pre-binding head.
+        if head.owner_workspace_id != Some(guard.workspace_id)
+            || head.next_sequence != 2
+            || lower.binding.binding_version != 1
+            || head.owned_slice_count != 0
+            || head.owned_bytes != 0
+            || base.layer_id != lower.binding.base_layer_id
+            || base.owner_workspace_id.is_some()
+            || base.sealed_version != Some(1)
+            || base.next_sequence != 2
+            || base.owned_slice_count != 0
+            || base.owned_bytes != 0
+        {
+            return Err(invalid());
+        }
+        let upper_delta = self
+            .store
+            .load_layer_delta(head.layer_id)
+            .await
+            .map_err(workspace_to_meta)?;
+        if upper_delta != CanonicalLayerDelta::default() {
+            return Err(invalid());
+        }
+        let stub = self
+            .store
+            .load_layer_delta(base.layer_id)
+            .await
+            .map_err(workspace_to_meta)?;
+        let [root] = stub.inodes.as_slice() else {
+            return Err(invalid());
+        };
+        if !no_native_rows_except_inode(&stub)
+            || root.layer_id != base.layer_id
+            || root.ino != self.root_ino()
+            || root.kind != super::file_type_code(crate::meta::store::FileType::Dir)
+            || root.state != InodeState::Present
+            || root.sequence != 1
+        {
+            return Err(invalid());
+        }
+        let digest = delta_digest(&stub).map_err(workspace_to_meta)?;
+        if base.delta_digest != Some(digest) || base.root_hash != Some(root_hash([0; 32], digest)) {
+            return Err(invalid());
+        }
+        // Scans occurred under the already-acquired exclusive writer lease.
+        // Recheck the exact guard and both unchanged layer records afterwards.
+        self.store
+            .validate_read_fence(guard.clone(), layers.clone())
+            .await
+            .map_err(workspace_to_meta)?;
+        self.packed_read_control
+            .set(Arc::new(PackedReadControlWitness {
+                mode,
+                guard: guard.clone(),
+                layers: layers.clone(),
+                extent_queries: AtomicU64::new(0),
+                extent_bypasses: AtomicU64::new(0),
+                native_root: root.ino,
+                root_preserved: AtomicU64::new(0),
+                namespace: Default::default(),
+            }))
+            .map_err(|_| MetaError::Internal("Packed read control was already installed".into()))?;
+        tracing::info!(
+            mode = mode.name(),
+            workspace = %guard.workspace_id,
+            head = %head.layer_id,
+            base = %base.layer_id,
+            packed_manifest_digest = %hex::encode(lower.binding.manifest.digest),
+            "Packed read control admitted: empty native upper and sealed root-only stub"
+        );
+        Ok(())
+    }
+
+    pub(super) fn packed_read_control_for_view(
+        &self,
+        guard: &HeadGuard,
+        layers: &[LayerRecord; 2],
+    ) -> Result<Option<&PackedReadControlWitness>, MetaError> {
+        let Some(witness) = self.packed_read_control.get().map(Arc::as_ref) else {
+            return Ok(None);
+        };
+        if &witness.guard != guard || &witness.layers != layers {
+            return Err(workspace_to_meta(WorkspaceError::Fenced));
+        }
+        Ok(Some(witness))
+    }
+
+    /// Both namespace arms prove the same empty-layer view before looking
+    /// at the native cache or lower. A local lease, when configured, may
+    /// authorize it only while the exact mount view remains authoritative.
+    pub(super) async fn packed_namespace_read_control(
+        &self,
+        guard: &HeadGuard,
+        layers: &[LayerRecord; 2],
+    ) -> Result<Option<&PackedReadControlWitness>, MetaError> {
+        if !self
+            .packed_read_control
+            .get()
+            .is_some_and(|control| control.mode.measures_namespace())
+        {
+            return Ok(None);
+        }
+        let Some(witness) = self.packed_read_control_for_view(guard, layers)? else {
+            return Err(workspace_to_meta(WorkspaceError::Fenced));
+        };
+        self.validate_packed_namespace_read_control(witness).await?;
+        Ok(Some(witness))
+    }
+
+    pub(super) async fn validate_packed_namespace_read_control(
+        &self,
+        witness: &PackedReadControlWitness,
+    ) -> Result<(), MetaError> {
+        if self.guard().await != witness.guard {
+            return Err(workspace_to_meta(WorkspaceError::Fenced));
+        }
+        if let Some(lease) = &self.lease_validity {
+            return if lease.authoritative() {
+                Ok(())
+            } else {
+                Err(workspace_to_meta(WorkspaceError::Fenced))
+            };
+        }
+        self.store
+            .validate_read_fence(witness.guard.clone(), witness.layers.clone())
+            .await
+            .map_err(workspace_to_meta)
+    }
+
+    pub(super) fn refuse_packed_read_control_mutation(&self) -> Result<(), std::io::Error> {
+        if self.packed_read_control.get().is_some() {
+            return Err(std::io::Error::from_raw_os_error(libc::EROFS));
+        }
+        Ok(())
+    }
+}
