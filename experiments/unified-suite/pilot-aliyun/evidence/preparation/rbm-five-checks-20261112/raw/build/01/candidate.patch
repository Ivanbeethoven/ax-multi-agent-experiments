+#[tokio::test]
+async fn packed_namespace_control_keeps_permissions_root_and_paged_directory() {
+    use crate::workspace_overlay::lifecycle::LeaseValidity;
+    use crate::workspace_overlay::meta_layer::PackedReadControl;
+
+    let mut baseline = None;
+    for mode in [PackedReadControl::OverlayRead, PackedReadControl::LowerRead] {
+        let lease = Arc::new(LeaseValidity::new(
+            std::time::Instant::now(),
+            std::time::Duration::from_secs(60),
+        ));
+        let f = fixture_with_lease(false, packed().await, Some(lease.clone())).await;
+        let original_root = f.meta.stat(1).await.unwrap().unwrap();
+        f.meta.enable_packed_read_control(mode).await.unwrap();
+
+        let mut attrs = Vec::new();
+        for _ in 0..2 {
+            let (ino, attr) = f
+                .meta
+                .lookup_with_attr_bytes(1, b"nonzero")
+                .await
+                .unwrap()
+                .unwrap();
+            assert_eq!(ino, attr.ino);
+            attrs.push((ino, attr.mode, attr.uid, attr.gid, attr.size));
+        }
+        assert!(
+            f.meta
+                .lookup_with_attr_bytes(1, b"not-present")
+                .await
+                .unwrap()
+                .is_none()
+        );
+        let root = f.meta.stat(1).await.unwrap().unwrap();
+        assert_eq!(
+            (root.mode, root.uid, root.gid),
+            (original_root.mode, original_root.uid, original_root.gid)
+        );
+        let permission = f.meta.inode_permissions(attrs[0].0).await.unwrap().unwrap();
+        assert_eq!(
+            (permission.attr.ino, permission.attr.mode),
+            (attrs[0].0, attrs[0].1)
+        );
+        let dir = f.meta.opendir(1).await.unwrap();
+        let first = dir.get_entries_page_raw_owned(0, 1).await.unwrap().entries;
+        assert_eq!(first[0].name, b"nonzero");
+        assert!(
+            dir.get_entries_page_raw_owned(1, 1)
+                .await
+                .unwrap()
+                .entries
+                .is_empty()
+        );
+        assert_eq!(
+            dir.get_entries_page_raw_owned(0, 1).await.unwrap().entries,
+            first
+        );
+        let observed = (attrs, first);
+        if let Some(baseline) = &baseline {
+            assert_eq!(&observed, baseline);
+        } else {
+            baseline = Some(observed);
+        }
+
+        let stats = crate::vfs::stats::FsStats::new();
+        assert!(f.meta.install_workspace_stats(&stats));
+        let rendered = stats
+            .render_bounded(stats.render_allocation_limit())
+            .unwrap();
+        let metric = |name: &str| -> u64 {
+            let prefix = format!("brewfs_workspace_read_namespace_control_{name} ");
+            rendered
+                .lines()
+                .find_map(|line| line.strip_prefix(prefix.as_str()))
+                .unwrap()
+                .parse()
+                .unwrap()
+        };
+        assert!(metric("root_preserved_total") > 0);
+        if mode == PackedReadControl::OverlayRead {
+            for op in ["lookup", "getattr"] {
+                assert!(metric(&format!("{op}_queries_total")) > 0);
+                assert!(metric(&format!("{op}_cache_hits_total")) > 0);
+                assert_eq!(metric(&format!("{op}_bypasses_total")), 0);
+            }
+            assert_eq!(metric("directory_probe_queries_total"), 2);
+            assert_eq!(metric("directory_probe_bypasses_total"), 0);
+        } else {
+            for op in ["lookup", "getattr", "directory_probe"] {
+                assert_eq!(metric(&format!("{op}_queries_total")), 0);
+                assert_eq!(metric(&format!("{op}_cache_hits_total")), 0);
+                assert!(metric(&format!("{op}_bypasses_total")) > 0);
+            }
+        }
+
+        lease.revoke();
+        assert!(f.meta.lookup_with_attr_bytes(1, b"nonzero").await.is_err());
+        assert!(dir.get_entries_page_raw_owned(0, 1).await.is_err());
+        drop(dir);
+        f.reader.shutdown().await.unwrap();
+    }
+}
