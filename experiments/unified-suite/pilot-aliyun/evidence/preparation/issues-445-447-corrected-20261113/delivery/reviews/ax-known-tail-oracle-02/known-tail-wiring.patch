     for tool in "${tools[@]}"; do
         case "$tool" in
+            known-tail-oracle)
+                run_known_tail_oracle || { touch "$artifact_dir/known-tail-oracle.invalid"; status=1; }
+                ;;
             dirstress)
                 run_dirstress || status=1
                 ;;
