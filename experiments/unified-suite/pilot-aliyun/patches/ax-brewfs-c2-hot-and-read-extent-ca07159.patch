+        1
+    );
+    assert_eq!(
+        rendered
+            .matches("brewfs_packed_v3_runtime_backend_range_gets_total ")
+            .count(),
+        1
+    );
+    assert_eq!(f.gets.load(Ordering::SeqCst), before);
+}
+
+#[tokio::test]
+async fn packed_read_extent_control_preserves_lower_bytes_and_rejects_writes() {
+    for (mode, queries, bypasses) in [
+        (PackedReadControl::Overlay, 1, 0),
+        (PackedReadControl::LowerOnly, 0, 1),
+    ] {
+        let f = fixture().await;
+        f.meta.enable_packed_read_control(mode).await.unwrap();
+        assert!(f.meta.force_read_only_fuse_mount());
+        assert!(matches!(
+            f.meta.create_file(1, "must-not-exist".into()).await,
+            Err(MetaError::Io(error)) if error.raw_os_error() == Some(libc::EROFS)
+        ));
+        let attr = f.meta.stat(400).await.unwrap().unwrap();
+        assert!(matches!(
+            f.meta.record_open(400, attr.clone(), false, true, false).await,
+            Err(MetaError::Io(error)) if error.raw_os_error() == Some(libc::EROFS)
+        ));
+        f.meta
+            .record_open(400, attr, true, false, false)
+            .await
+            .unwrap();
+
+        let fence = f
+            .meta
+            .begin_unified_read_request(400)
+            .await
+            .unwrap()
+            .unwrap();
+        let prepared = f
+            .meta
+            .prepare_unified_read(400, 0, 9, 55)
+            .await
+            .unwrap()
+            .unwrap();
+        let mut output = [0; 55];
+        execute_unified_into(prepared.fetcher.as_ref(), 9, &prepared.plan, &mut output)
+            .await
+            .unwrap();
+        fence.ensure_current().await.unwrap();
+        f.meta.record_close(400).await.unwrap();
+        assert_eq!(&output, &f.payload[9..64]);
+        assert_eq!(f.upper.reads.load(Ordering::SeqCst), 0);
+
+        let stats = crate::vfs::stats::FsStats::new();
+        assert!(f.meta.install_workspace_stats(&stats));
+        let rendered = stats
+            .render_bounded(stats.render_allocation_limit())
+            .unwrap();
+        assert!(rendered.contains(&format!(
+            "brewfs_workspace_read_extent_control_queries_total {queries}\n"
+        )));
+        assert!(rendered.contains(&format!(
+            "brewfs_workspace_read_extent_control_bypasses_total {bypasses}\n"
+        )));
+    }
+}
