{
  "mount_point": "/mnt/slayerfs/mount",
  "meta": {
    "backend": "redis",
    "redis": {
      "url": "redis://127.0.0.1:6379/1"
    }
  },
  "data": {
    "backend": "s3",
    "s3": {
      "bucket": "coldread-4gib",
      "endpoint": "http://127.0.0.1:9000",
      "region": "us-east-1",
      "force_path_style": true,
      "disable_payload_checksum": true
    }
  },
  "cache": {
    "cache_root": "/mnt/slayerfs/results/retest-fixed/coldread-ab/cache-import",
    "read_memory_bytes": 536870912,
    "read_ssd_bytes": 0,
    "write_memory_bytes": 268435456,
    "write_ssd_bytes": 1073741824,
    "upload_concurrency": 8,
    "compression": "none",
    "writeback_mode": "upload_before_commit"
  },
  "fuse": {
    "privileged": true
  }
}
