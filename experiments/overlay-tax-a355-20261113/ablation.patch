+#[tokio::test]
+async fn read_ablation_preserves_contents_and_rejects_writes() {
+    use crate::chunk::read_plan::WorkspaceReadPlanProvider;
+    use crate::workspace::meta_layer::PackedReadControl;
+    for mode in [PackedReadControl::OverlayRead, PackedReadControl::LowerRead] {
+        let f = fixture(false).await;
+        f.meta.enable_packed_read_control(mode).await.unwrap();
+        assert_eq!(f.meta.lookup(1, "nonzero").await.unwrap(), Some(400));
+        let attr = f.meta.stat(400).await.unwrap().unwrap();
+        assert_eq!(attr.size, f.payload.len() as u64);
+        let directory = f.meta.opendir(1).await.unwrap();
+        let entries = directory.get_entries_page_raw_owned(0, 8).await.unwrap();
+        assert_eq!(entries.entries.len(), 1);
+        assert_eq!(entries.entries[0].name, b"nonzero");
+        drop(entries);
+        let prepared = f
+            .meta
+            .prepare_unified_read(400, 0, 0, CHUNK)
+            .await
+            .unwrap()
+            .unwrap();
+        let mut output = Vec::new();
+        for segment in &prepared.plan.segments {
+            let mut bytes = vec![0; segment.length as usize];
+            prepared
+                .fetcher
+                .read_source(&segment.source, &mut bytes)
+                .await
+                .unwrap();
+            output.extend(bytes);
+        }
+        assert_eq!(output, f.payload[..CHUNK as usize]);
+        assert!(f.meta.create_file(1, "forbidden".into()).await.is_err());
+        assert!(f.vfs.chmod(400, 0o600).await.is_err());
+        assert_eq!(f.meta.stat(400).await.unwrap().unwrap().mode, attr.mode);
+        drop(directory);
+        drop(prepared);
+        f.reader.shutdown().await.unwrap();
+    }
+}
